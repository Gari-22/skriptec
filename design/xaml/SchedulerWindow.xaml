<Window x:Class="ScriptMaster.SchedulerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nastaviť spúšťanie" Height="560" Width="720"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="#F7F6F2">

    <Window.Resources>
        <SolidColorBrush x:Key="PurpleBrush"       Color="#534AB7"/>
        <SolidColorBrush x:Key="PurpleLightBrush"  Color="#EEEDFE"/>
        <SolidColorBrush x:Key="BorderBrush"        Color="#E0DED8"/>
        <SolidColorBrush x:Key="SurfaceBrush"       Color="#F7F6F2"/>
        <SolidColorBrush x:Key="AppBg"             Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextPrimary"        Color="#1A1A1A"/>
        <SolidColorBrush x:Key="TextSecondary"      Color="#5F5E5A"/>
        <SolidColorBrush x:Key="SuccessBrush"       Color="#3B6D11"/>
        <SolidColorBrush x:Key="SuccessLightBrush"  Color="#EAF3DE"/>

        <!-- Trigger nav item -->
        <Style x:Key="TriggerItem" TargetType="RadioButton">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="GroupName" Value="TriggerGroup"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PurpleLightBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource PurpleBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BorderBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Day pill toggle -->
        <Style x:Key="DayPill" TargetType="ToggleButton">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0.5"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="20" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{StaticResource PurpleLightBrush}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource PurpleBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource PurpleBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Repeat pill (single select via RadioButton) -->
        <Style x:Key="RepeatPill" TargetType="RadioButton">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0.5"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="GroupName" Value="RepeatGroup"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="20" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{StaticResource PurpleLightBrush}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource PurpleBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource PurpleBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle switch style -->
        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border Width="32" Height="18" CornerRadius="9"
                                x:Name="Track" Background="{StaticResource BorderBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0.5">
                            <Ellipse x:Name="Knob" Width="14" Height="14"
                                     Fill="White" HorizontalAlignment="Left" Margin="1,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource SuccessLightBrush}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource SuccessBrush}"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,1,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Input field -->
        <Style x:Key="InputField" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0.5"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox -->
        <Style x:Key="InputCombo" TargetType="ComboBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0.5"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Height" Value="30"/>
        </Style>

        <!-- Primary button -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
            <Setter Property="Background" Value="{StaticResource SuccessLightBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}"/>
            <Setter Property="BorderThickness" Value="0.5"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0.5"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource AppBg}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0.5" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Header -->
                <RowDefinition Height="*"/>     <!-- Body -->
                <RowDefinition Height="Auto"/>  <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0" Padding="18,14"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,0.5">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Width="28" Height="28"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            IsCancel="True">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="{StaticResource TextSecondary}"/>
                    </Button>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE916;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                   VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="{StaticResource PurpleBrush}"/>
                        <TextBlock Text="Nastaviť spúšťanie" FontFamily="Segoe UI" FontSize="14"
                                   FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Border Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0.5"
                                CornerRadius="10" Padding="8,2">
                            <TextBlock Text="deploy-prod.ps1" FontFamily="Cascadia Code, Consolas"
                                       FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- BODY -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>  <!-- Trigger nav -->
                    <ColumnDefinition Width="*"/>    <!-- Config panel -->
                </Grid.ColumnDefinitions>

                <!-- Trigger navigation -->
                <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0.5,0">
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Text="TYP TRIGGERA" FontFamily="Segoe UI" FontSize="10"
                                   FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"
                                   Margin="12,0,12,6"/>
                        <RadioButton Style="{StaticResource TriggerItem}" IsChecked="True"
                                     x:Name="TriggerSchedule">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Plán (cron)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource TriggerItem}" x:Name="TriggerStartup">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Spustenie PC" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource TriggerItem}" x:Name="TriggerLogin">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8D4;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Prihlásenie" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource TriggerItem}" x:Name="TriggerFile">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7C3;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Zmena súboru" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource TriggerItem}" x:Name="TriggerManual">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7C9;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Manuálne" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <Rectangle Height="0.5" Fill="{StaticResource BorderBrush}" Margin="12,8"/>

                        <TextBlock Text="MOŽNOSTI" FontFamily="Segoe UI" FontSize="10"
                                   FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"
                                   Margin="12,0,12,6"/>
                        <RadioButton Style="{StaticResource TriggerItem}" x:Name="TriggerParams"
                                     GroupName="OptionsGroup">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE90E;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Parametre" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource TriggerItem}" x:Name="TriggerNotif"
                                     GroupName="OptionsGroup">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEA8F;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Notifikácie" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>

                <!-- Config panel -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,16,20,16">

                        <!-- Section: Opakovanie -->
                        <TextBlock Text="OPAKOVANIE" FontFamily="Segoe UI" FontSize="10"
                                   FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"
                                   Margin="0,0,0,8"/>
                        <WrapPanel Margin="0,0,0,16">
                            <RadioButton Style="{StaticResource RepeatPill}" Content="Každú minútu"/>
                            <RadioButton Style="{StaticResource RepeatPill}" Content="Každú hodinu"/>
                            <RadioButton Style="{StaticResource RepeatPill}" Content="Denne" IsChecked="True"/>
                            <RadioButton Style="{StaticResource RepeatPill}" Content="Týždenne"/>
                            <RadioButton Style="{StaticResource RepeatPill}" Content="Mesačne"/>
                            <RadioButton Style="{StaticResource RepeatPill}" Content="Vlastné"/>
                        </WrapPanel>

                        <!-- Section: Dni -->
                        <TextBlock Text="DNI" FontFamily="Segoe UI" FontSize="10"
                                   FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"
                                   Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <ToggleButton Style="{StaticResource DayPill}" Content="Po" IsChecked="True"/>
                            <ToggleButton Style="{StaticResource DayPill}" Content="Ut" IsChecked="True"/>
                            <ToggleButton Style="{StaticResource DayPill}" Content="St" IsChecked="True"/>
                            <ToggleButton Style="{StaticResource DayPill}" Content="Št" IsChecked="True"/>
                            <ToggleButton Style="{StaticResource DayPill}" Content="Pi" IsChecked="True"/>
                            <ToggleButton Style="{StaticResource DayPill}" Content="So"/>
                            <ToggleButton Style="{StaticResource DayPill}" Content="Ne"/>
                        </StackPanel>

                        <!-- Section: Čas -->
                        <TextBlock Text="ČAS SPUSTENIA" FontFamily="Segoe UI" FontSize="10"
                                   FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"
                                   Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Hodina" FontFamily="Segoe UI" FontSize="11"
                                           Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                                <TextBox Style="{StaticResource InputField}" Width="70" Text="09"
                                         x:Name="InputHour"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Minúta" FontFamily="Segoe UI" FontSize="11"
                                           Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                                <TextBox Style="{StaticResource InputField}" Width="70" Text="00"
                                         x:Name="InputMinute"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Časové pásmo" FontFamily="Segoe UI" FontSize="11"
                                           Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                                <ComboBox Style="{StaticResource InputCombo}" Width="180"
                                          x:Name="TimeZoneCombo" SelectedIndex="0">
                                    <ComboBoxItem>Europe/Bratislava</ComboBoxItem>
                                    <ComboBoxItem>UTC</ComboBoxItem>
                                    <ComboBoxItem>US/Eastern</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>

                        <!-- Section: Správanie -->
                        <TextBlock Text="SPRÁVANIE" FontFamily="Segoe UI" FontSize="10"
                                   FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"
                                   Margin="0,0,0,8"/>

                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0.5"
                                CornerRadius="6" Background="{StaticResource SurfaceBrush}"
                                Padding="12,9" Margin="0,0,0,6">
                            <DockPanel>
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}"
                                          IsChecked="True" VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock Text="Spustiť aj ak bol PC vypnutý"
                                               FontFamily="Segoe UI" FontSize="12"
                                               Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="Dobehne zmeškaný beh po zapnutí"
                                               FontFamily="Segoe UI" FontSize="11"
                                               Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0.5"
                                CornerRadius="6" Background="{StaticResource SurfaceBrush}"
                                Padding="12,9" Margin="0,0,0,6">
                            <DockPanel>
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}"
                                          IsChecked="True" VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock Text="Spustiť na pozadí"
                                               FontFamily="Segoe UI" FontSize="12"
                                               Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="Bez viditeľného okna konzoly"
                                               FontFamily="Segoe UI" FontSize="11"
                                               Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0.5"
                                CornerRadius="6" Background="{StaticResource SurfaceBrush}"
                                Padding="12,9" Margin="0,0,0,16">
                            <DockPanel>
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}"
                                          IsChecked="False" VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock Text="Notifikácia pri chybe"
                                               FontFamily="Segoe UI" FontSize="12"
                                               Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="Toast upozornenie ak exit code ≠ 0"
                                               FontFamily="Segoe UI" FontSize="11"
                                               Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Section: Preview -->
                        <TextBlock Text="VÝSLEDNÝ PLÁN" FontFamily="Segoe UI" FontSize="10"
                                   FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"
                                   Margin="0,0,0,8"/>
                        <Border Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0.5"
                                CornerRadius="6" Padding="12,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <TextBlock Text="Cron: " FontFamily="Segoe UI" FontSize="11"
                                               Foreground="{StaticResource TextSecondary}"/>
                                    <TextBlock Text="0 9 * * 1-5" FontFamily="Cascadia Code, Consolas"
                                               FontSize="11" Foreground="{StaticResource TextPrimary}"
                                               FontWeight="SemiBold" x:Name="PreviewCron"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <TextBlock Text="Čas: " FontFamily="Segoe UI" FontSize="11"
                                               Foreground="{StaticResource TextSecondary}"/>
                                    <TextBlock Text="09:00, Po–Pi" FontFamily="Segoe UI" FontSize="11"
                                               Foreground="{StaticResource TextPrimary}"
                                               FontWeight="SemiBold" x:Name="PreviewTime"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Ďalší beh: " FontFamily="Segoe UI" FontSize="11"
                                               Foreground="{StaticResource TextSecondary}"/>
                                    <TextBlock Text="zajtra o 09:00" FontFamily="Segoe UI" FontSize="11"
                                               Foreground="{StaticResource TextPrimary}"
                                               FontWeight="SemiBold" x:Name="PreviewNext"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- FOOTER -->
            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0.5,0,0"
                    Padding="18,12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock Text="Ďalší beh: zajtra 09:00" FontFamily="Segoe UI" FontSize="11"
                                   Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"
                                   x:Name="FooterNextRun"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Style="{StaticResource SecondaryButton}" Content="Zrušiť"
                                IsCancel="True" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource PrimaryButton}" IsDefault="True"
                                x:Name="SaveButton">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Uložiť plán" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

        </Grid>
    </Border>
</Window>
