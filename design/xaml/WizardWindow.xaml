<Window x:Class="ScriptMaster.WizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nový skript – sprievodca" Height="580" Width="680"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="#FFFFFF">

    <Window.Resources>
        <SolidColorBrush x:Key="PurpleBrush"      Color="#534AB7"/>
        <SolidColorBrush x:Key="PurpleLightBrush" Color="#EEEDFE"/>
        <SolidColorBrush x:Key="BorderBrush"       Color="#E0DED8"/>
        <SolidColorBrush x:Key="SurfaceBrush"      Color="#F7F6F2"/>
        <SolidColorBrush x:Key="TextPrimary"       Color="#1A1A1A"/>
        <SolidColorBrush x:Key="TextSecondary"     Color="#5F5E5A"/>
        <SolidColorBrush x:Key="SuccessBrush"      Color="#3B6D11"/>
        <SolidColorBrush x:Key="SuccessLightBrush" Color="#EAF3DE"/>

        <!-- Type card -->
        <Style x:Key="TypeCard" TargetType="RadioButton">
            <Setter Property="GroupName" Value="TypeGroup"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Width="140" Height="80"
                                Background="#FFFFFF"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0.5" CornerRadius="8"
                                Padding="12">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="Icon" Text="&#xE7C3;"
                                           FontFamily="Segoe MDL2 Assets" FontSize="20"
                                           HorizontalAlignment="Center" Margin="0,0,0,5"
                                           Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock x:Name="Title" HorizontalAlignment="Center"
                                           FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"
                                           TextAlignment="Center"/>
                                <TextBlock x:Name="Sub" HorizontalAlignment="Center"
                                           FontFamily="Segoe UI" FontSize="10"
                                           Foreground="{StaticResource TextSecondary}"
                                           TextAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PurpleBrush}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PurpleLightBrush}"/>
                                <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource PurpleBrush}"/>
                                <Setter TargetName="Title" Property="Foreground" Value="{StaticResource PurpleBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Step dot -->
        <Style x:Key="StepDotActive" TargetType="Ellipse">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Fill" Value="{StaticResource PurpleLightBrush}"/>
            <Setter Property="Stroke" Value="{StaticResource PurpleBrush}"/>
            <Setter Property="StrokeThickness" Value="0.5"/>
        </Style>
        <Style x:Key="StepDotDone" TargetType="Ellipse">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Fill" Value="{StaticResource SuccessLightBrush}"/>
            <Setter Property="Stroke" Value="{StaticResource SuccessBrush}"/>
            <Setter Property="StrokeThickness" Value="0.5"/>
        </Style>
        <Style x:Key="StepDotInactive" TargetType="Ellipse">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Fill" Value="White"/>
            <Setter Property="Stroke" Value="{StaticResource BorderBrush}"/>
            <Setter Property="StrokeThickness" Value="0.5"/>
        </Style>

        <!-- Form input -->
        <Style x:Key="FormInput" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0.5"/>
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormCombo" TargetType="ComboBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0.5"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Height" Value="32"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- Nav buttons -->
        <Style x:Key="NavBack" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0.5"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavNext" TargetType="Button" BasedOn="{StaticResource NavBack}">
            <Setter Property="Background" Value="{StaticResource PurpleLightBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource PurpleBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PurpleBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="NavCreate" TargetType="Button" BasedOn="{StaticResource NavBack}">
            <Setter Property="Background" Value="{StaticResource SuccessLightBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0.5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Header -->
                <RowDefinition Height="Auto"/>  <!-- Steps bar -->
                <RowDefinition Height="*"/>     <!-- Content -->
                <RowDefinition Height="Auto"/>  <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0" Padding="18,14"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,0.5"
                    Background="{StaticResource SurfaceBrush}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Width="28" Height="28"
                            Background="Transparent" BorderThickness="0" IsCancel="True" Cursor="Hand">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="{StaticResource TextSecondary}"/>
                    </Button>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                   Margin="0,0,8,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource PurpleBrush}"/>
                        <TextBlock Text="Nový skript – sprievodca" FontFamily="Segoe UI"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- STEPS BAR -->
            <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,0.5"
                    Padding="20,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                    <!-- Step 1: Done -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="22" Height="22">
                            <Ellipse Style="{StaticResource StepDotDone}"/>
                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource SuccessBrush}"/>
                        </Grid>
                        <TextBlock Text="Typ" FontFamily="Segoe UI" FontSize="11"
                                   Foreground="{StaticResource SuccessBrush}" Margin="5,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Rectangle Width="30" Height="0.5" Fill="{StaticResource BorderBrush}" Margin="8,0"/>

                    <!-- Step 2: Active -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="22" Height="22">
                            <Ellipse Style="{StaticResource StepDotActive}"/>
                            <TextBlock Text="2" FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource PurpleBrush}"/>
                        </Grid>
                        <TextBlock Text="Nastavenia" FontFamily="Segoe UI" FontSize="11"
                                   FontWeight="SemiBold" Foreground="{StaticResource PurpleBrush}"
                                   Margin="5,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Rectangle Width="30" Height="0.5" Fill="{StaticResource BorderBrush}" Margin="8,0"/>

                    <!-- Step 3: Inactive -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="22" Height="22">
                            <Ellipse Style="{StaticResource StepDotInactive}"/>
                            <TextBlock Text="3" FontFamily="Segoe UI" FontSize="10"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondary}"/>
                        </Grid>
                        <TextBlock Text="Parametre" FontFamily="Segoe UI" FontSize="11"
                                   Foreground="{StaticResource TextSecondary}" Margin="5,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Rectangle Width="30" Height="0.5" Fill="{StaticResource BorderBrush}" Margin="8,0"/>

                    <!-- Step 4: Inactive -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="22" Height="22">
                            <Ellipse Style="{StaticResource StepDotInactive}"/>
                            <TextBlock Text="4" FontFamily="Segoe UI" FontSize="10"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondary}"/>
                        </Grid>
                        <TextBlock Text="Umiestnenie" FontFamily="Segoe UI" FontSize="11"
                                   Foreground="{StaticResource TextSecondary}" Margin="5,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Rectangle Width="30" Height="0.5" Fill="{StaticResource BorderBrush}" Margin="8,0"/>

                    <!-- Step 5: Inactive -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="22" Height="22">
                            <Ellipse Style="{StaticResource StepDotInactive}"/>
                            <TextBlock Text="5" FontFamily="Segoe UI" FontSize="10"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondary}"/>
                        </Grid>
                        <TextBlock Text="Náhľad" FontFamily="Segoe UI" FontSize="11"
                                   Foreground="{StaticResource TextSecondary}" Margin="5,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- CONTENT: Step 2 - Nastavenia (Backup type) -->
            <!-- V kóde prepínaš Visibility podľa aktuálneho kroku -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,20,24,20" x:Name="StepContent">

                    <TextBlock Text="Základné nastavenia zálohovania"
                               FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}" Margin="0,0,0,16"/>

                    <!-- Row 1: Názov + Jazyk -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Názov skriptu" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource FormInput}" x:Name="ScriptName"
                                     Text="backup-dokumenty"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Jazyk" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Style="{StaticResource FormCombo}" x:Name="LanguageCombo"
                                      SelectedIndex="0">
                                <ComboBoxItem>PowerShell</ComboBoxItem>
                                <ComboBoxItem>Bash</ComboBoxItem>
                                <ComboBoxItem>Python</ComboBoxItem>
                                <ComboBoxItem>Batch</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- Row 2: Zdrojový priečinok -->
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Zdrojový priečinok" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource FormInput}"
                                     x:Name="SourcePath" Text="C:\Users\Jan\Documents"/>
                            <Button Grid.Column="2" Style="{StaticResource NavBack}" Content="Prehľadávať…"
                                    FontSize="11"/>
                        </Grid>
                    </StackPanel>

                    <!-- Row 3: Cieľový priečinok -->
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Cieľový priečinok (záloha)" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource FormInput}"
                                     x:Name="DestPath" Text="D:\Zalohy\Dokumenty"/>
                            <Button Grid.Column="2" Style="{StaticResource NavBack}" Content="Prehľadávať…"
                                    FontSize="11"/>
                        </Grid>
                    </StackPanel>

                    <!-- Row 4: Options -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Čo zálohovať" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Style="{StaticResource FormCombo}" SelectedIndex="0">
                                <ComboBoxItem>Všetky súbory</ComboBoxItem>
                                <ComboBoxItem>Len zmenené</ComboBoxItem>
                                <ComboBoxItem>Podľa prípony</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Pomenovanie zálohy" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Style="{StaticResource FormCombo}" SelectedIndex="0">
                                <ComboBoxItem>S dátumom</ComboBoxItem>
                                <ComboBoxItem>Prepísať</ComboBoxItem>
                                <ComboBoxItem>Verziovať</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- Popis -->
                    <StackPanel Margin="0,0,0,0">
                        <TextBlock Text="Popis (voliteľné)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource FormInput}" AcceptsReturn="True" Height="60"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 Text="Záloha priečinka Dokumenty na externý disk D: s dátumovou pečiatkou."
                                 x:Name="Description"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- FOOTER -->
            <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0.5,0,0"
                    Padding="20,12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="Krok 2 z 5 – Nastavenia"
                               FontFamily="Segoe UI" FontSize="11"
                               Foreground="{StaticResource TextSecondary}"
                               VerticalAlignment="Center" x:Name="StepLabel"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Style="{StaticResource NavBack}" Content="← Späť"
                                Margin="0,0,8,0" x:Name="BackButton"/>
                        <Button Style="{StaticResource NavNext}" x:Name="NextButton">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Ďalej" VerticalAlignment="Center"/>
                                <TextBlock Text=" →" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

        </Grid>
    </Border>
</Window>
