<Window x:Class="Skriptec.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ae="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="Skriptec" Height="720" Width="1200"
        MinHeight="500" MinWidth="800"
        Background="{DynamicResource AppBackground}">

    <Window.Resources>
        <!-- Kontajner položiek stromu (sidebar) – vzhľad z mockupu -->
        <Style x:Key="SidebarTreeItemStyle" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="True"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <Border x:Name="Bd" Padding="0" Background="Transparent">
                                <ContentPresenter x:Name="PART_Header" ContentSource="Header"/>
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource PurpleLightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource BorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Top bar -->
            <RowDefinition Height="*"/>     <!-- Main content -->
            <RowDefinition Height="Auto"/>  <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ═══════════════ TOP BAR ═══════════════ -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,0.5">
            <DockPanel Height="42" Margin="12,0">

                <!-- Logo -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,0,20,0">
                    <Ellipse Width="20" Height="20" Fill="{DynamicResource PurpleBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="Skriptec" FontFamily="Segoe UI" FontSize="14"
                               FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Search -->
                <Border DockPanel.Dock="Left" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0.5" CornerRadius="6" Width="260"
                        Background="{DynamicResource AppBackground}"
                        VerticalAlignment="Center" Margin="0,0,12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="12" Margin="8,0,6,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBox Grid.Column="1" BorderThickness="0" Background="Transparent"
                                 FontFamily="Segoe UI" FontSize="12" Padding="0,7"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 x:Name="SearchBox" Text=""
                                 ToolTip="Hľadaj skripty (Ctrl+F)">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <Grid>
                                                    <TextBlock Text="Hľadaj skripty…"
                                                               FontFamily="Segoe UI" FontSize="12"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               Margin="0,7,0,0" IsHitTestVisible="False">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <ScrollViewer x:Name="PART_ContentHost"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Grid>
                </Border>

                <!-- Right actions -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button Style="{StaticResource ToolbarButton}" Margin="4,0,0,0"
                            ToolTip="Databáza šablón">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7BF;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Šablóny" VerticalAlignment="Center"
                                       FontFamily="Segoe UI" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}" Margin="4,0,0,0"
                            ToolTip="Nastavenia">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                   VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>

            </DockPanel>
        </Border>

        <!-- ═══════════════ MAIN AREA (Sidebar | Editor | MetaPanel) ═══════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="160" MaxWidth="340"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="190" MinWidth="160" MaxWidth="280"/>
            </Grid.ColumnDefinitions>

            <!-- ── SIDEBAR ── -->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0.5,0">
                <DockPanel>

                    <!-- Sidebar header -->
                    <Border DockPanel.Dock="Top" Padding="12,8"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,0.5">
                        <DockPanel>
                            <TextBlock Text="Skripty" FontFamily="Segoe UI" FontSize="12"
                                       FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                            <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}"
                                    HorizontalAlignment="Right"
                                    Width="24" Height="24" Padding="0" ToolTip="Nový zošit">
                                <TextBlock Text="+" FontSize="16" FontFamily="Segoe UI"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Button>
                        </DockPanel>
                    </Border>

                    <!-- Sidebar bottom: New script button -->
                    <Border DockPanel.Dock="Bottom" Padding="10,8"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0.5,0,0">
                        <Button Style="{StaticResource ToolbarButton}" HorizontalAlignment="Stretch"
                                ToolTip="Nový skript">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="+" FontSize="14" Margin="0,0,6,0"
                                           VerticalAlignment="Center" FontFamily="Segoe UI"/>
                                <TextBlock Text="Nový skript" FontFamily="Segoe UI" FontSize="12"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Border>

                    <!-- Tree view (naplní sa v M2) -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <TreeView x:Name="ScriptTree" BorderThickness="0"
                                  Background="Transparent" Padding="0,4"
                                  ItemContainerStyle="{StaticResource SidebarTreeItemStyle}"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- GridSplitter 1 -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="{DynamicResource BorderBrush}" Cursor="SizeWE"/>

            <!-- ── EDITOR PANEL ── -->
            <DockPanel Grid.Column="2">

                <!-- Tab bar (záložky pribudnú v M3) -->
                <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,0.5">
                    <StackPanel x:Name="TabBar" Orientation="Horizontal" Height="36"/>
                </Border>

                <!-- Toolbar -->
                <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,0.5" Padding="8,5">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource RunButton}" Margin="0,0,4,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Spustiť" FontFamily="Segoe UI" FontSize="12"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Separator Width="0.5" Margin="4,2"/>
                        <Button Style="{StaticResource ToolbarButton}" Margin="4,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE916;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Naplánovať" FontFamily="Segoe UI" FontSize="12"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolbarButton}" Margin="4,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Kopírovať" FontFamily="Segoe UI" FontSize="12"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolbarButton}" Margin="4,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Export" FontFamily="Segoe UI" FontSize="12"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Separator Width="0.5" Margin="4,2"/>
                        <Button Style="{StaticResource ToolbarButton}" Margin="4,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="História" FontFamily="Segoe UI" FontSize="12"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Editor status bar (bottom) -->
                <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0.5,0,0" Padding="10,4">
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource BadgePurple}" Margin="0,0,8,0">
                            <TextBlock Text="PowerShell" FontFamily="Segoe UI" FontSize="10"
                                       FontWeight="SemiBold" Foreground="{DynamicResource PurpleBrush}"/>
                        </Border>
                        <TextBlock Text="Riadok 1, St. 1" Style="{StaticResource TextSecondary}"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock Text="UTF-8 · CRLF" Style="{StaticResource TextSecondary}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Editor (AvalonEditB) -->
                <ae:TextEditor x:Name="CodeEditor"
                               ShowLineNumbers="True"
                               BorderThickness="0"
                               Background="Transparent"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               LineNumbersForeground="{DynamicResource TextSecondaryBrush}"
                               FontFamily="Cascadia Code, Consolas"
                               FontSize="13"
                               Padding="8,10"
                               HorizontalScrollBarVisibility="Auto"
                               VerticalScrollBarVisibility="Auto"/>
            </DockPanel>

            <!-- GridSplitter 2 -->
            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch"
                          Background="{DynamicResource BorderBrush}" Cursor="SizeWE"/>

            <!-- ── META PANEL ── -->
            <Border Grid.Column="4" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0.5,0,0,0">
                <DockPanel>

                    <!-- Schedule button (bottom) -->
                    <Border DockPanel.Dock="Bottom" Padding="10,8"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0.5,0,0">
                        <Button Style="{StaticResource ToolbarButton}" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE916;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Naplánovať spúšťanie" FontFamily="Segoe UI"
                                           FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>

                            <!-- Metadata section -->
                            <Border Padding="12,10,12,10"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,0.5">
                                <StackPanel>
                                    <TextBlock Text="METADÁTA" Style="{StaticResource SectionLabel}" Margin="0,0,0,6"/>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Zošit" Style="{StaticResource TextSecondary}" Grid.Column="0"/>
                                        <TextBlock Text="—" Style="{StaticResource TextMono}" Grid.Column="1"/>
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Sekcia" Style="{StaticResource TextSecondary}" Grid.Column="0"/>
                                        <TextBlock Text="—" Style="{StaticResource TextMono}" Grid.Column="1"/>
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Jazyk" Style="{StaticResource TextSecondary}" Grid.Column="0"/>
                                        <TextBlock Text="—" Style="{StaticResource TextMono}" Grid.Column="1"/>
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Veľkosť" Style="{StaticResource TextSecondary}" Grid.Column="0"/>
                                        <TextBlock Text="—" Style="{StaticResource TextMono}" Grid.Column="1"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Tags section (tagy pribudnú v M2) -->
                            <Border Padding="12,10,12,10"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,0.5">
                                <StackPanel>
                                    <TextBlock Text="TAGY" Style="{StaticResource SectionLabel}" Margin="0,0,0,6"/>
                                    <WrapPanel x:Name="TagsPanel"/>
                                </StackPanel>
                            </Border>

                            <!-- Run history section (história pribudne v M4) -->
                            <Border Padding="12,10,12,10">
                                <StackPanel>
                                    <TextBlock Text="POSLEDNÉ SPUSTENIA" Style="{StaticResource SectionLabel}" Margin="0,0,0,6"/>
                                    <StackPanel x:Name="RunHistoryPanel"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

        </Grid>

        <!-- ═══════════════ STATUS BAR ═══════════════ -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0.5,0,0" Padding="12,4">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="Skriptec v1.0"
                           Style="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" Margin="0,0,6,0"/>
                    <TextBlock Text="Pripravený" Style="{StaticResource TextSecondary}"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
